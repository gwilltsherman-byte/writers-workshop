# Local PostgreSQL. Netlify Database supplies NETLIFY_DB_URL when enabled.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/writers_workshop?schema=public

# Generate with openssl rand -base64 32. Required for guest/player identities.
AUTH_SECRET=

# Optional in development. Production account signup needs SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Writers Workshop <noreply@example.local>"

# The app's HTTPS URL in production; local address during Mac development.
APP_BASE_URL=http://localhost:3000
