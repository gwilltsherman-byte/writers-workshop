# ---- Database (required) ----------------------------------------------------
# A hosted Postgres works well with Netlify: Neon, Supabase, or Railway.
# Use a pooled connection string (Neon/Supabase "pooler") for serverless.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/writers_workshop?schema=public

# ---- Auth (required in production) ------------------------------------------
# Secret used to sign session JWTs. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# ---- Email (optional) -------------------------------------------------------
# If unset, signup/verification codes are logged and shown in the UI (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Writers Workshop <noreply@writers.work>"

# Public base URL of the deployed site (used in verification emails).
APP_BASE_URL=http://localhost:3000

# ---- Realtime (optional) ----------------------------------------------------
# Netlify can't host the Socket.IO/Yjs server. Leave blank for a graceful
# "live server required" state on realtime pages. To enable realtime in
# production, deploy server/index.ts to an always-on host (Render/Railway/Fly)
# and set this to that server's URL, e.g. https://realtime.yourapp.com
NEXT_PUBLIC_REALTIME_URL=

NODE_ENV=development
