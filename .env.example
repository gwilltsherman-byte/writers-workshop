# PostgreSQL connection for the app. Codespaces supplies its own development DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/writers_workshop?schema=public

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Email is optional in development; production signup needs SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Writers Workshop <noreply@example.local>"

# Public origin; localhost for Mac development.
APP_BASE_URL=http://localhost:3000

# Leave empty when the app and live server run on the same host.
NEXT_PUBLIC_REALTIME_URL=
NODE_ENV=development
